# Copy to .env.local and fill in real values. Vars prefixed with VITE_
# are exposed to the browser bundle — don't put server-only secrets here.

# Ledger service API key. In dev, must match a key in
# LandingPage/Ledger/.env (API_KEYS). In prod, will move to a
# server-side proxy so the key isn't shipped to the browser.
VITE_LEDGER_API_KEY=
